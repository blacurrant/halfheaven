# HalfHeaven - split architecture (halfheaven frontend + halfhell backend)
# Copy to .env.local and fill in. .env.local is gitignored and never committed.
# Real environment variables take precedence over this file.

# ── halfhell backend ───────────────────────────────────────────────────
# The Python FastAPI service that does fingerprint / pipeline / scoring.
# Frontend (Next.js) talks to it with an API key. Generate a key:
#   openssl rand -hex 32
HALFHELL_API_URL=http://localhost:8000
HALFHELL_API_KEY=change-me-generate-with-openssl-rand-hex-32
# For rotation you can set HALFHELL_API_KEYS=old,new

# ── Groq (LLM / ASR / Vision) ───────────────────────────────────────────
# Now consumed by halfhell only; frontend no longer calls Groq directly.
# Keep this here so halfhell can read it when running via `halfheaven` cwd,
# or set it in halfhell/.env instead.
GROQ_API_KEY=

# Pinned model ids. Groq rotates these; halfhell verifies at boot and refuses
# to start rather than failing mid-job.
GROQ_MODEL_ASR=whisper-large-v3-turbo
GROQ_MODEL_LLM=openai/gpt-oss-120b
GROQ_MODEL_VISION=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── legacy (optional) ──────────────────────────────────────────────────
# HALFHELL_WORK_ROOT=./.halfhell-work
# HALFHELL_CORS_ORIGINS=http://localhost:3000
