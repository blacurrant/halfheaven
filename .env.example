# Copy to .env.local and fill in. .env.local is gitignored and never committed.
# Real environment variables take precedence over this file, so a deployment
# can set them without a file existing at all.

GROQ_API_KEY=

# Pinned model ids. Groq rotates these; they are verified at boot and the app
# refuses to start rather than failing mid-job.
GROQ_MODEL_ASR=whisper-large-v3-turbo
GROQ_MODEL_LLM=openai/gpt-oss-120b
GROQ_MODEL_VISION=qwen/qwen3.8-27b
